{
  "name": "golden-gym-2-0-native",
  "version": "1.0.0",
  "private": true,
  "description": "Android and Windows desktop wrappers for Golden Gym 2.0",
  "main": "desktop/main.cjs",
  "scripts": {
    "android:prepare": "cap add android && cap sync android",
    "android:sync": "cap sync android",
    "desktop:build": "electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/core": "^7.4.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12"
    "typescript": "^5.9.3"
  },
  "build": {
    "appId": "com.goldengym.app",
    "productName": "Golden Gym 2.0",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Golden-Gym-2.0-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
